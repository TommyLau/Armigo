function(armigo_feature_array output)
    set(json "[]")
    set(index 0)
    foreach(value IN LISTS ARGN)
        string(REPLACE "${CMAKE_BINARY_DIR}" "<build>" value "${value}")
        string(REPLACE "${CMAKE_SOURCE_DIR}" "<source>" value "${value}")
        string(REPLACE "\\" "\\\\" value "${value}")
        string(REPLACE "\"" "\\\"" value "${value}")
        string(JSON json SET "${json}" ${index} "\"${value}\"")
        math(EXPR index "${index} + 1")
    endforeach()
    set(${output} "${json}" PARENT_SCOPE)
endfunction()

function(armigo_write_player_features)
    set(core "{}")
    get_property(targets DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY BUILDSYSTEM_TARGETS)
    list(FILTER targets INCLUDE REGEX "^armigo_services_")
    list(SORT targets)
    armigo_feature_array(services ${targets})
    string(JSON core SET "${core}" horizon_services "${services}")
    set(service_sources "{}")
    set(service_definitions "{}")
    foreach(target IN LISTS targets)
        get_target_property(sources ${target} SOURCES)
        list(SORT sources)
        armigo_feature_array(source_json ${sources})
        string(JSON service_sources SET "${service_sources}" "${target}" "${source_json}")
        get_target_property(definitions ${target} COMPILE_DEFINITIONS)
        if(NOT definitions)
            set(definitions "")
        endif()
        list(SORT definitions)
        armigo_feature_array(definition_json ${definitions})
        string(JSON service_definitions SET "${service_definitions}" "${target}" "${definition_json}")
    endforeach()
    string(JSON core SET "${core}" service_sources "${service_sources}")
    string(JSON core SET "${core}" service_definitions "${service_definitions}")
    get_target_property(runtime_links armigo_runtime LINK_LIBRARIES)
    list(FILTER runtime_links EXCLUDE REGEX "^::@")
    list(SORT runtime_links)
    armigo_feature_array(runtime_json ${runtime_links})
    string(JSON core SET "${core}" runtime_links "${runtime_json}")
    foreach(feature hwopus zbic native_shader)
        if(feature STREQUAL hwopus)
            get_target_property(definitions armigo_services_hwopus COMPILE_DEFINITIONS)
            if(NOT "ARMIGO_HAS_OPUS=1" IN_LIST definitions)
                message(FATAL_ERROR "The required hardware audio decoder is disabled.")
            endif()
        elseif(feature STREQUAL zbic)
            get_target_property(definitions armigo_loader COMPILE_DEFINITIONS)
            if(NOT "ARMIGO_HAS_ZSTD=1" IN_LIST definitions)
                message(FATAL_ERROR "The required compressed module decoder is disabled.")
            endif()
        elseif(NOT TARGET armigo_shader_native_frontend)
            message(FATAL_ERROR "The required native shader frontend is missing.")
        endif()
        string(JSON core SET "${core}" "${feature}" true)
    endforeach()
    set(dependencies "{}")
    foreach(dependency opus zstd)
        string(TOUPPER "${dependency}" upper)
        if(dependency STREQUAL opus)
            set(target opus)
        else()
            set(target libzstd_static)
        endif()
        get_target_property(type ${target} TYPE)
        get_target_property(imported ${target} IMPORTED)
        if(imported OR NOT type STREQUAL STATIC_LIBRARY)
            message(FATAL_ERROR "Player dependencies must be built from verified sources as static libraries.")
        endif()
        set(description "{}")
        string(JSON description SET "${description}" version "\"${ARMIGO_${upper}_VERSION}\"")
        string(JSON description SET "${description}" sha256 "\"${ARMIGO_${upper}_SHA256}\"")
        foreach(property COMPILE_DEFINITIONS COMPILE_OPTIONS)
            get_target_property(values ${target} ${property})
            if(NOT values)
                set(values "")
            endif()
            list(SORT values)
            armigo_feature_array(values_json ${values})
            string(JSON description SET "${description}" "${property}" "${values_json}")
        endforeach()
        get_target_property(dependency_directory ${target} SOURCE_DIR)
        foreach(flag CMAKE_C_FLAGS CMAKE_C_FLAGS_RELEASE)
            get_directory_property(value DIRECTORY "${dependency_directory}" DEFINITION ${flag})
            armigo_feature_array(flag_json "${value}")
            string(JSON description SET "${description}" "${flag}" "${flag_json}")
        endforeach()
        string(JSON dependencies SET "${dependencies}" "${dependency}" "${description}")
    endforeach()
    set(platform "{}")
    if(ARMIGO_IOS)
        set(window UIKit)
        set(audio RemoteIO)
        set(code embedded)
    else()
        set(window AppKit)
        set(audio HAL)
        set(code native_or_embedded)
    endif()
    string(JSON platform SET "${platform}" window "\"${window}\"")
    string(JSON platform SET "${platform}" audio_device "\"${audio}\"")
    string(JSON platform SET "${platform}" code_loading "\"${code}\"")
    set(manifest "{}")
    string(JSON manifest SET "${manifest}" core "${core}")
    string(JSON manifest SET "${manifest}" dependencies "${dependencies}")
    string(JSON manifest SET "${manifest}" platform "${platform}")
    file(WRITE "${CMAKE_BINARY_DIR}/armigo-player-features.json" "${manifest}\n")
endfunction()
armigo_write_player_features()
